{
  "expo": {
    "name": "Swachh Bharat Mission Foundation",
    "slug": "sbm-foundation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sbmfoundation",
    "primaryColor": "#138808",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1440"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sbmfoundation.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to set pickup/drop points and to tag complaints accurately.",
        "NSCameraUsageDescription": "We use the camera to capture photos for complaints and document uploads.",
        "NSPhotoLibraryUsageDescription": "We access your photos so you can attach images to applications and complaints."
      }
    },
    "android": {
      "package": "com.sbmfoundation.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#138808"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SBM Foundation to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SBM Foundation to access your photos.",
          "cameraPermission": "Allow SBM Foundation to use your camera."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "0ed7a298-cc8c-48f0-a54f-e209ecb56bad"
      }
    }
  }
}
